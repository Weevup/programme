// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // For local auth (hashed)
  role          UserRole  @default(USER)

  // Relations
  accounts      Account[]
  sessions      Session[]
  createdEvents Event[]   @relation("EventCreator")

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
  PARTNER
  CLIENT
}

// ============================================
// EVENTS
// ============================================

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(DRAFT)

  // Configuration
  languages   String[]    // ["fr", "en"]
  timezone    String      @default("Europe/Paris")

  // Budget tracking
  budgetTotal Decimal?    @db.Decimal(10, 2)

  // Relations
  createdById String
  createdBy   User        @relation("EventCreator", fields: [createdById], references: [id])

  venues      EventVenue[]
  sessions    Session_Event[]
  participants Participant[]
  segments    Segment[]
  checkIns    CheckIn[]
  surveys     Survey[]

  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// VENUES & PARTNERS
// ============================================

model Venue {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  type        VenueType

  // Location
  address     String
  city        String
  country     String
  postalCode  String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)

  // Capacity & specs
  totalCapacity Int?

  // Pricing
  priceRange  String?  // "€€-€€€"

  // RSE/ESG scoring
  rseScore    Int?     // 0-100

  // Contact
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  // Relations
  rooms       VenueRoom[]
  media       VenueMedia[]
  events      EventVenue[]

  // Internal tracking
  status      VenueStatus @default(ACTIVE)
  notes       String?      @db.Text

  // Timestamps
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("venues")
}

model VenueRoom {
  id              String   @id @default(cuid())
  venueId         String
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name            String
  capacity        Int
  area            Decimal? @db.Decimal(8, 2) // m²

  // Setup configurations
  setupTheater    Int?     // Theater setup capacity
  setupClassroom  Int?     // Classroom setup capacity
  setupBanquet    Int?     // Banquet setup capacity
  setupCocktail   Int?     // Cocktail setup capacity

  // Equipment & features
  hasProjector    Boolean  @default(false)
  hasSound        Boolean  @default(false)
  hasWifi         Boolean  @default(true)
  hasAirCon       Boolean  @default(false)
  isAccessible    Boolean  @default(false)

  floor           Int?

  // Relations
  sessions        Session_Event[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("venue_rooms")
}

model VenueMedia {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  type      MediaType
  url       String
  alt       String?
  order     Int       @default(0)

  createdAt DateTime  @default(now())

  @@map("venue_media")
}

model EventVenue {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id])

  isPrimary Boolean @default(false)

  @@unique([eventId, venueId])
  @@map("event_venues")
}

enum VenueType {
  CONFERENCE_CENTER
  HOTEL
  OUTDOOR
  RESTAURANT
  MUSEUM
  THEATER
  OTHER
}

enum VenueStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  FLOOR_PLAN
}

// ============================================
// PARTNERS (Caterers, Animators, etc.)
// ============================================

model Partner {
  id          String        @id @default(cuid())
  name        String
  type        PartnerType
  description String?       @db.Text

  // Contact
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  // Service areas
  cities      String[]
  countries   String[]

  // Quality tracking
  rating      Decimal?      @db.Decimal(3, 2) // 0.00 - 5.00

  status      PartnerStatus @default(ACTIVE)
  notes       String?       @db.Text

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("partners")
}

enum PartnerType {
  CATERING
  ANIMATION
  TRANSPORT
  ACCOMMODATION
  AV_TECH
  DECORATION
  SECURITY
  OTHER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

// ============================================
// PROGRAM / AGENDA
// ============================================

model Session_Event {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?       @db.Text
  type        SessionType

  // Timing
  startTime   DateTime
  endTime     DateTime

  // Location
  venueRoomId String?
  venueRoom   VenueRoom?    @relation(fields: [venueRoomId], references: [id])
  location    String?       // Custom location text

  // Capacity
  maxCapacity Int?

  // Speakers
  speakers    Speaker[]

  // Visibility & access
  isPublic    Boolean       @default(true)
  segments    SessionSegment[]

  // Content
  language    String?       // "fr", "en"
  tags        String[]

  // Resources
  documents   SessionDocument[]

  // Interaction
  interactions SessionInteraction[]
  feedbacks   SessionFeedback[]
  checkIns    CheckIn[]

  // Internal
  status      SessionStatus @default(DRAFT)
  notes       String?       @db.Text

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("sessions")
}

model SessionSegment {
  id        String        @id @default(cuid())
  sessionId String
  session   Session_Event @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  segmentId String
  segment   Segment       @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, segmentId])
  @@map("session_segments")
}

model SessionDocument {
  id        String        @id @default(cuid())
  sessionId String
  session   Session_Event @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title     String
  type      DocumentType
  url       String
  fileSize  Int?

  createdAt DateTime      @default(now())

  @@map("session_documents")
}

model Speaker {
  id          String        @id @default(cuid())
  sessionId   String
  session     Session_Event @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name        String
  title       String?       // Job title
  company     String?
  bio         String?       @db.Text
  photo       String?
  email       String?

  order       Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("speakers")
}

enum SessionType {
  PLENARY
  WORKSHOP
  BREAK
  MEAL
  NETWORKING
  ENTERTAINMENT
  OTHER
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentType {
  PDF
  PRESENTATION
  IMAGE
  VIDEO
  OTHER
}

// ============================================
// PARTICIPANTS & SEGMENTS
// ============================================

model Participant {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Personal info
  email         String
  firstName     String
  lastName      String
  company       String?
  jobTitle      String?
  phone         String?

  // Participant type
  role          ParticipantRole @default(ATTENDEE)

  // Registration
  registeredAt  DateTime    @default(now())
  status        ParticipantStatus @default(INVITED)

  // QR Code for check-in
  qrCode        String      @unique @default(cuid())

  // Preferences
  language      String      @default("fr")
  dietaryReqs   String?

  // Segmentation
  segments      ParticipantSegment[]

  // Logistics
  needsTransport Boolean    @default(false)
  needsAccommodation Boolean @default(false)

  // GDPR
  consentMarketing Boolean  @default(false)
  consentData      Boolean  @default(true)
  consentDate      DateTime?

  // Relations
  checkIns      CheckIn[]
  feedbacks     SessionFeedback[]
  surveyResponses SurveyResponse[]

  // Custom fields (JSON for flexibility)
  customFields  Json?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventId, email])
  @@map("participants")
}

model Segment {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?     @db.Text
  color       String?     // Hex color for UI

  // Smart segment (dynamic rules)
  isSmartList Boolean     @default(false)
  rules       Json?       // JSON rules for dynamic segmentation

  // Relations
  participants ParticipantSegment[]
  sessions    SessionSegment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("segments")
}

model ParticipantSegment {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  segmentId     String
  segment       Segment     @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([participantId, segmentId])
  @@map("participant_segments")
}

enum ParticipantRole {
  ATTENDEE
  SPEAKER
  SPONSOR
  STAFF
  VIP
  PRESS
}

enum ParticipantStatus {
  INVITED
  REGISTERED
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

// ============================================
// CHECK-IN
// ============================================

model CheckIn {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  sessionId     String?
  session       Session_Event? @relation(fields: [sessionId], references: [id])

  checkInTime   DateTime      @default(now())
  checkInType   CheckInType   @default(EVENT)
  location      String?       // Check-in point name

  // Who performed the check-in
  scannerUserId String?

  @@map("check_ins")
}

enum CheckInType {
  EVENT           // Main event check-in
  SESSION         // Session-specific check-in
  MEAL            // Meal check-in
  TRANSPORT       // Transport check-in
}

// ============================================
// INTERACTIONS (Q&A, Polls, Quiz, etc.)
// ============================================

model SessionInteraction {
  id          String           @id @default(cuid())
  sessionId   String
  session     Session_Event    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type        InteractionType
  question    String           @db.Text

  // For polls/quiz
  options     Json?            // Array of options
  correctAnswer String?        // For quiz

  isActive    Boolean          @default(true)

  // Responses
  responses   InteractionResponse[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("session_interactions")
}

model InteractionResponse {
  id            String              @id @default(cuid())
  interactionId String
  interaction   SessionInteraction  @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  participantId String?
  answer        String              @db.Text
  isCorrect     Boolean?            // For quiz

  createdAt     DateTime            @default(now())

  @@map("interaction_responses")
}

enum InteractionType {
  QA          // Q&A
  POLL        // Poll/Vote
  QUIZ        // Quiz
  WORDCLOUD   // Word Cloud
}

// ============================================
// FEEDBACK & SURVEYS
// ============================================

model SessionFeedback {
  id            String        @id @default(cuid())
  sessionId     String
  session       Session_Event @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)

  rating        Int           // 1-5
  comment       String?       @db.Text

  createdAt     DateTime      @default(now())

  @@unique([sessionId, participantId])
  @@map("session_feedbacks")
}

model Survey {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?         @db.Text

  // When to show
  triggerType SurveyTrigger   @default(MANUAL)
  startDate   DateTime?
  endDate     DateTime?

  // Questions
  questions   SurveyQuestion[]

  // Responses
  responses   SurveyResponse[]

  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("surveys")
}

model SurveyQuestion {
  id        String            @id @default(cuid())
  surveyId  String
  survey    Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  question  String            @db.Text
  type      QuestionType
  required  Boolean           @default(false)
  order     Int               @default(0)

  // For multiple choice
  options   Json?             // Array of options

  // Responses
  answers   SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyResponse {
  id            String          @id @default(cuid())
  surveyId      String
  survey        Survey          @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  answers       SurveyAnswer[]

  completedAt   DateTime        @default(now())

  @@unique([surveyId, participantId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String          @id @default(cuid())
  questionId String
  question   SurveyQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseId String
  response   SurveyResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)

  answer     String          @db.Text

  @@map("survey_answers")
}

enum SurveyTrigger {
  MANUAL        // Admin triggers
  POST_EVENT    // After event ends
  POST_SESSION  // After each session
}

enum QuestionType {
  TEXT
  TEXTAREA
  RATING
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
}

// ============================================
// AUDIT LOGS (for versioning & tracking)
// ============================================

model AuditLog {
  id          String   @id @default(cuid())

  entityType  String   // "Event", "Session", etc.
  entityId    String
  action      String   // "CREATE", "UPDATE", "DELETE"

  userId      String?
  changes     Json?    // Diff of changes

  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
